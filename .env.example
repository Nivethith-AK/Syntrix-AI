# =============================================================================
# Syntrix AI — Phase 1 environment template
# Copy to `.env` (never commit real secrets). Frontend also uses `frontend/.env.local`.
# =============================================================================

# --- App ---
APP_ENV=development
APP_NAME=Syntrix AI
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Supabase Cloud (REQUIRED) — PostgreSQL + Auth + Storage ---
# Local Supabase CLI / Compose Postgres is NOT the primary path. Use a cloud project.
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → Database → Connection string (URI; Session mode OK for API)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# JWT secret (Project Settings → API → JWT Secret) — validates Bearer access tokens
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Auth: Google + email verification + password reset ---
# Configure in Supabase Dashboard (project matching SUPABASE_URL):
#
# 1) Authentication → URL Configuration
#    Site URL: http://localhost:3000
#    Redirect URLs (add all):
#      http://localhost:3000/auth/callback
#      http://localhost:3000/update-password
#
# 2) Authentication → Providers → Email
#    Enable Email provider
#    Enable "Confirm email" so signup auto-sends verification emails
#
# 3) Authentication → Providers → Google
#    Enable Google
#    Paste Google Cloud OAuth Client ID + Client Secret
#    Authorized redirect URI in Google Cloud must be:
#      https://YOUR_PROJECT.supabase.co/auth/v1/callback
#
# 4) Authentication → Emails (templates) — optional branding
#    Confirm signup / Reset password templates are sent automatically by Supabase
#
# Client ID/Secret stay in the Supabase dashboard (not this file).

# --- Resend (custom SMTP for reliable auth emails) ---
# Fastest path (Dashboard):
#   Supabase → Authentication → Email → SMTP Settings → Enable Custom SMTP
#     Host: smtp.resend.com
#     Port: 465
#     Username: resend
#     Password: <RESEND_API_KEY>
#     Sender email: onboarding@resend.dev  (or you@verified-domain.com)
#     Sender name: Syntrix AI
#   Also enable Confirm email under Authentication → Providers → Email
#
# Scripted path (Management API):
#   RESEND_API_KEY + SUPABASE_ACCESS_TOKEN in .env
#   uv run python scripts/configure_supabase_resend_smtp.py
#   uv run python scripts/test_resend_send.py you@example.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Syntrix AI <onboarding@resend.dev>
SUPABASE_ACCESS_TOKEN=

# --- Redis (Celery broker only — not used for app state / checkpoints / vectors) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI provider abstraction (skeleton in Phase 1; full agents in Phase 4) ---
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
# Optional OpenAI-compatible remote path
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Supabase Storage (Phase 2 upload/profile) ---
STORAGE_BUCKET_DATASETS=datasets
STORAGE_BUCKET_MODELS=models
STORAGE_BUCKET_REPORTS=reports
UPLOAD_MAX_BYTES=104857600
UPLOAD_PREVIEW_ROWS=50
UPLOAD_ALLOWED_EXTENSIONS=csv,parquet,xlsx,xls

# --- MLflow (optional Compose service; not required for Phase 1 demo job) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- MCP / Research (Phase 4–5) ---
# Keep mock on for demos; set to 0 only with network allowlists reviewed.
RESEARCH_MCP_MOCK=1

# --- Frontend (also copy public vars into frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
