# =============================================================================
# Syntrix AI — Phase 1 environment template
# Copy to `.env` (never commit real secrets). Frontend also uses `frontend/.env.local`.
# =============================================================================

# --- App ---
APP_ENV=development
APP_NAME=Syntrix AI
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Supabase Cloud (REQUIRED) — PostgreSQL + Auth + Storage ---
# Local Supabase CLI / Compose Postgres is NOT the primary path. Use a cloud project.
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → Database → Connection string (URI; Session mode OK for API)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# JWT secret (Project Settings → API → JWT Secret) — validates Bearer access tokens
SUPABASE_JWT_SECRET=your-jwt-secret

# Google OAuth (Supabase Dashboard → Authentication → Providers → Google)
# Allowed redirect URL: http://localhost:3000/auth/callback
# Client ID/Secret are configured in the Supabase dashboard, not in this file.

# --- Resend (email) ---
# Phase 1 primary path: configure Supabase Auth custom SMTP with Resend
# (Dashboard → Authentication → SMTP Settings), then auth emails work without
# the app sending mail itself.
#   Host: smtp.resend.com
#   Port: 465 (SSL) or 587 (STARTTLS)
#   Username: resend
#   Password: <RESEND_API_KEY>
#   Sender email: a verified domain address (or onboarding@resend.dev for tests)
# Optional app-level API (future transactional mail); leave blank until needed:
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Redis (Celery broker only — not used for app state / checkpoints / vectors) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI provider abstraction (skeleton in Phase 1; full agents in Phase 4) ---
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
# Optional OpenAI-compatible remote path
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Supabase Storage (Phase 2 upload/profile) ---
STORAGE_BUCKET_DATASETS=datasets
STORAGE_BUCKET_MODELS=models
STORAGE_BUCKET_REPORTS=reports
UPLOAD_MAX_BYTES=104857600
UPLOAD_PREVIEW_ROWS=50
UPLOAD_ALLOWED_EXTENSIONS=csv,parquet,xlsx,xls

# --- MLflow (optional Compose service; not required for Phase 1 demo job) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Frontend (also copy public vars into frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
